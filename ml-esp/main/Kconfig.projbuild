menu "MeguminLink"

config MEGUMINLINK_USB_SUPPORT
    bool "Enable USB (TinyUSB) support"
    default y
    depends on IDF_TARGET_ESP32S3
    help
        Compile the USB/TinyUSB support code. The USB OTG
        peripheral is only available on ESP32-S3, so this option is only
        configurable when building for that target; on other targets the
        file is always excluded from the build.

config MEGUMINLINK_USB_MAX_PACKET_SIZE
    int "USB max packet size"
    default 512
    depends on MEGUMINLINK_USB_SUPPORT

config MEGUMINLINK_USB_PACKET_BUFFER_DEPTH
    int "USB packet buffer depth"
    default 8
    depends on MEGUMINLINK_USB_SUPPORT

config MEGUMINLINK_USB_UART_BRIDGE_ENABLE
    bool "Enable UART bridge (CDC ACM)"
    default y
    depends on MEGUMINLINK_USB_SUPPORT
    help
        Compile the UART bridge and expose a CDC ACM interface on USB.
        When disabled, the USB device only exposes the CMSIS-DAP
        interface and no serial port is visible to the host.

if MEGUMINLINK_USB_UART_BRIDGE_ENABLE

config MEGUMINLINK_UART_RX_BUFFER_SIZE
    int "UART receive buffer size"
    default 256

config MEGUMINLINK_UART_TX_BUFFER_SIZE
    int "UART send buffer size"
    default 256

config MEGUMINLINK_UART_EVENT_QUEUE_SIZE
    int "UART event queue size"
    default 16

config MEGUMINLINK_UART_BRIDGE_NUM
    int "UART bridge peripheral num"
    default 1
    range 1 2

config MEGUMINLINK_UART_BRIDGE_TX_IO
    int "UART bridge TX GPIO number"
    default 17

config MEGUMINLINK_UART_BRIDGE_RX_IO
    int "UART bridge RX GPIO number"
    default 18

config MEGUMINLINK_UART_BRIDGE_BAUD_RATE
    int "UART bridge baud rate"
    default 115200

endif

if MEGUMINLINK_USB_SUPPORT

config MEGUMINLINK_DAP_SWCLK_IO
    int "CMSIS-DAP SWCLK/TCK GPIO number"
    default 4

config MEGUMINLINK_DAP_SWDIO_IO
    int "CMSIS-DAP SWDIO/TMS GPIO number"
    default 5

config MEGUMINLINK_DAP_NRESET_IO
    int "CMSIS-DAP nRESET GPIO number"
    default 6

config MEGUMINLINK_DAP_TDI_IO
    int "CMSIS-DAP TDI GPIO number"
    default 7

config MEGUMINLINK_DAP_TDO_IO
    int "CMSIS-DAP TDO GPIO number"
    default 8

config MEGUMINLINK_DAP_NTRST_IO
    int "CMSIS-DAP nTRST GPIO number"
    default 9

endif

config MEGUMINLINK_MODE_SWITCH_ENABLE
    bool "Enable debug mode switch button (double click)"
    default y
    help
        Detect a double click on a button and toggle between local (USB
        CMSIS-DAP) and wireless debug modes. Disable to strip the button
        driver (e.g. when the GPIO is needed for something else).

if MEGUMINLINK_MODE_SWITCH_ENABLE

config MEGUMINLINK_MODE_SWITCH_GPIO
    int "Mode switch button GPIO number"
    default 0
    range 0 48
    help
        Button GPIO, active low (internal pull-up, falling edge on press).
        Default GPIO0 (BOOT button). Note: GPIO0 is a strapping pin - holding
        it low during power-up enters ROM download mode.

config MEGUMINLINK_MODE_SWITCH_DOUBLE_CLICK_MS
    int "Mode switch double-click window (ms)"
    default 400
    help
        Maximum interval between two presses (falling edges) to count as a
        double click.

endif

endmenu
