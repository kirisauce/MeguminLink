# MeguminLink S3 PV2 板：模式切换按钮 IO35，板载 WS2812 数据在 IO9
CONFIG_MEGUMINLINK_MODE_SWITCH_GPIO=35
CONFIG_MEGUMINLINK_LED_DRIVER_WS2812_GPIO=9
# 板上 CMSIS-DAP（SWD/JTAG）与串口桥引脚
CONFIG_MEGUMINLINK_DAP_SWCLK_IO=17
CONFIG_MEGUMINLINK_DAP_SWDIO_IO=18
CONFIG_MEGUMINLINK_DAP_NRESET_IO=6
CONFIG_MEGUMINLINK_DAP_TDI_IO=15
CONFIG_MEGUMINLINK_DAP_TDO_IO=16
CONFIG_MEGUMINLINK_UART_BRIDGE_TX_IO=4
CONFIG_MEGUMINLINK_UART_BRIDGE_RX_IO=5
